{
  "product": "Red Bull Energy Drink — original 250 ml slim can (unofficial concept project)",
  "models": {
    "still": { "model": "gpt_image_2", "aspect_ratio": "16:9", "resolution": "2k" },
    "video": { "model": "seedance_2_0", "resolution": "4k", "generate_audio": false }
  },
  "seed": 1987,
  "notes": {
    "video_model": "seedance_2_0 has NO seed and NO negative-prompt parameters; continuity comes entirely from the locked start image. Always image-to-video, never text-to-video.",
    "download": "Always download the job's result_url. Never *_min / *_resize preview URLs.",
    "review": "Every take gets a review strip (scripts/review_strip.py) and a human-eye pass before acceptance. Gate on: RED BULL wordmark legible and correctly spelled, double-bull logo intact, slim 250ml proportions (not a stubby soda can), no duplicate cans, no hands, no watermarks."
  },
  "prompt_composition": {
    "order": ["shot_move", "subject", "style_bible"],
    "files": {
      "subject": "prompts/subject.txt",
      "style_bible": "prompts/style-bible.txt",
      "negative_review_criteria": "prompts/negative.txt"
    }
  },
  "anchors": {
    "hero": {
      "file": "takes/anchors/hero.png",
      "prompt_file": "prompts/anchors/hero-still.txt",
      "note": "Lock this FIRST. Iterate until perfect, then NEVER change it. Every exterior shot animates it."
    },
    "lid": {
      "file": "takes/anchors/lid.png",
      "prompt_file": "prompts/anchors/lid-still.txt",
      "reference": "reference/ (owner photo of the stay-tab lid, if provided)",
      "note": "Use owner photo as --image reference for identity; describe the RELIGHT into the studio look, never a new scene."
    },
    "pour": {
      "file": "takes/anchors/pour.png",
      "prompt_file": "prompts/anchors/pour-still.txt"
    },
    "ingredients": {
      "file": "takes/anchors/ingredients.png",
      "prompt_file": "prompts/anchors/ingredients-still.txt"
    },
    "element": {
      "file": "takes/anchors/element.png",
      "prompt_file": "prompts/anchors/element-still.txt"
    }
  },
  "shots": {
    "A": { "kind": "video", "duration": 5, "start_image": "takes/anchors/hero.png", "prompt_file": "prompts/shots/A-hero-orbit.txt", "output": "takes/A.mp4", "feeds": "hero scrub" },
    "B": { "kind": "video", "duration": 4, "start_image": "takes/anchors/hero.png", "prompt_file": "prompts/shots/B-logo-push.txt", "output": "takes/B.mp4", "feeds": "connective scrub" },
    "C1": { "kind": "video", "duration": 4, "start_image": "takes/anchors/hero.png", "prompt_file": "prompts/shots/C1-approach.txt", "output": "takes/C1.mp4", "feeds": "opening scrub (part 1)" },
    "C2": { "kind": "video", "duration": 4, "start_image": "takes/anchors/lid.png", "prompt_file": "prompts/shots/C2-opening.txt", "output": "takes/C2.mp4", "feeds": "opening scrub (part 2, xfade dissolve)" },
    "D": { "kind": "video", "duration": 4, "start_image": "takes/anchors/lid.png", "prompt_file": "prompts/shots/D-lid-drift.txt", "output": "takes/D.mp4", "feeds": "ambient loop (mirrored palindrome)" },
    "E1": { "kind": "video", "duration": 4, "start_image": "takes/anchors/hero.png", "prompt_file": "prompts/shots/E1-track.txt", "output": "takes/E1.mp4", "feeds": "pour scrub (part 1)" },
    "E2": { "kind": "video", "duration": 4, "start_image": "takes/anchors/pour.png", "prompt_file": "prompts/shots/E2-pour.txt", "output": "takes/E2.mp4", "feeds": "pour scrub (part 2, xfade dissolve)" },
    "F": { "kind": "video", "duration": 4, "start_image": "takes/anchors/ingredients.png", "prompt_file": "prompts/shots/F-ingredients.txt", "output": "takes/F.mp4", "feeds": "ambient loop (mirror if ends differ)" },
    "G": { "kind": "video", "duration": 5, "start_image": "takes/anchors/element.png", "prompt_file": "prompts/shots/G-element.txt", "output": "takes/G.mp4", "feeds": "outro loop" },
    "H": { "kind": "video", "duration": 4, "start_image": "takes/anchors/hero.png", "prompt_file": "prompts/shots/H-turntable.txt", "output": "takes/H.mp4", "feeds": "96-frame turntable" },
    "T1": { "kind": "video", "duration": 4, "start_image": "retrofit/pins/A-last.png", "end_image": "retrofit/pins/B-first.png", "prompt_file": "prompts/shots/T1-orbit-close.txt", "output": "takes/T1.mp4", "feeds": "bridge A->B (orbit closes)" },
    "T2": { "kind": "video", "duration": 4, "start_image": "retrofit/pins/B-last.png", "end_image": "retrofit/pins/C2-first.png", "prompt_file": "prompts/shots/T2-rise-to-lid.txt", "output": "takes/T2.mp4", "feeds": "bridge B->C2 (rise to lid)" },
    "T3": { "kind": "video", "duration": 4, "start_image": "retrofit/pins/C2-last.png", "end_image": "retrofit/pins/E2-first.png", "prompt_file": "prompts/shots/T3-tip-and-pour.txt", "output": "takes/T3.mp4", "feeds": "bridge C2->E2 (tip and pour)" }
  },
  "film": {
    "note": "One continuous camera journey. Cut from the film: C1 (wide approach after a push-in = reversal) and E1 (wide track after a macro = reversal); both stay in takes/ as standalone clips. Bridges T1-T3 are dual-pinned seedance takes; each bridge's end image IS the actual first frame of what follows in this cut.",
    "desktop": { "width": 2560, "quality": 84, "dir": "public/film" },
    "mobile":  { "width": 1080, "quality": 78, "dir": "public/film-m" },
    "segments": [
      { "id": "A",  "label": "SHOT A — HERO ORBIT",       "source": "takes/A.mp4",  "frames": 120, "frames_m": 60, "budget_mb": 16, "budget_mb_m": 3 },
      { "id": "T1", "label": "TRANSIT — THE ORBIT CLOSES", "source": "takes/T1.mp4", "frames": 48,  "frames_m": 24, "budget_mb": 8,  "budget_mb_m": 1.5 },
      { "id": "B",  "label": "SHOT B — LOGO PUSH-IN",      "source": "takes/B.mp4",  "frames": 90,  "frames_m": 45, "budget_mb": 16, "budget_mb_m": 3 },
      { "id": "T2", "label": "TRANSIT — RISE TO THE LID",  "source": "takes/T2.mp4", "frames": 48,  "frames_m": 24, "budget_mb": 8,  "budget_mb_m": 1.5 },
      { "id": "C2", "label": "SHOT C — THE OPENING",       "source": "takes/C2.mp4", "frames": 90,  "frames_m": 45, "budget_mb": 16, "budget_mb_m": 3 },
      { "id": "T3", "label": "TRANSIT — TIP AND POUR",     "source": "takes/T3.mp4", "frames": 48,  "frames_m": 24, "budget_mb": 8,  "budget_mb_m": 1.5 },
      { "id": "E2", "label": "SHOT E — THE POUR",          "source": "takes/E2.mp4", "frames": 90,  "frames_m": 45, "budget_mb": 16, "budget_mb_m": 3 }
    ]
  },
  "turntable": {
    "source": "takes/H.mp4",
    "frames": 96, "width": 1920, "quality": 80, "budget_mb": 12,
    "dir": "public/turn/original",
    "source_chroma_hex": "#1E3F8F",
    "colorways": [
      { "id": "original", "name": "Original", "line": "The one that started it all. 1987.", "hex": "#1E3F8F", "recolor": false }
    ]
  },
  "loops": {
    "lid":     { "source": "takes/D.mp4", "palindrome": true,  "width": 1920, "out_mp4": "public/loops/lid.mp4",     "out_webm": "public/loops/lid.webm" },
    "bubbles": { "source": "takes/F.mp4", "palindrome": true,  "width": 1920, "out_mp4": "public/loops/bubbles.mp4", "out_webm": "public/loops/bubbles.webm" },
    "element": { "source": "takes/G.mp4", "palindrome": false, "width": 1920, "out_mp4": "public/loops/element.mp4", "out_webm": "public/loops/element.webm" }
  },
  "budgets": {
    "webp_quality_step_down": 8,
    "webp_quality_floor": 40,
    "rule": "Over budget: step quality down by 8 and re-encode. Below q40: reshoot. Cut frames before resolution."
  }
}
